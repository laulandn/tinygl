/* As in fixed.h:
 *	0.00048828125 = 1/FIXED_SCALE 
 */
#define RAVEFixedToFloat(X) ((X >> 8) * 0.00048828125f)

#define MESA_COLOR_TO_RGB(rgb,r,g,b,a) { rgb.red = r << 8; rgb.green = g << 8; rgb.blue = b << 8;}
#define GET_PRIVATE_DATA(ctx,myPrivate)	TRADriverPrivate* myPrivate = (TRADriverPrivate*)(((AGLContext) ctx->DriverCtx)->driverPrivate); 


