/***********************************************************************************************
 *
 * RAUpdateState: UpdateState() is called whenver Mesa thinks the device driver should update 
 *				   its state and/or the other pointers (such as PointsFunc, LineFunc, 
 *				   or TriangleFunc).
 *
 ***********************************************************************************************/

static void RAUpdateState( GLcontext *ctx )
{
  GET_PRIVATE_DATA(ctx,myPrivate);
  /* 
   * Initialize all the pointers in the DD struct.  Do this whenever 
   * a new context is made current or we change buffers via set_buffer! 
   */
  
  ctx->Driver.SetBuffer = RASetBuffer;
  ctx->Driver.Clear = RAClear;
  ctx->Driver.ClearColor = RAClearColor;
  ctx->Driver.Color = RAColor;
  
  ctx->Driver.GetBufferSize = RAGetBufferSize;
  
  ctx->Driver.WriteColorSpan =RAWriteColorSpan;
  ctx->Driver.WriteMonocolorSpan = RAWriteMonocolorSpan;
  
  ctx->Driver.WriteColorPixels = RAWriteColorPixels;
  ctx->Driver.WriteMonocolorPixels = RAWriteMonocolorPixels;
  
  /*
   * Set up accelerated point/line/triangle functions:
   */
  ctx->Driver.TriangleFunc = RADrawTriangle;
  ctx->Driver.LineFunc = RADrawLine;
}


/************************************************************************************************
 * 
 * RAChooseMode: implements aglChoosePixelFmt chooses a pixel format from the minimum pixelformat.
 *
 ***********************************************************************************************/

static AGLPixelFmt RAChooseMode(
						const TAGLPixelFmtReq* inPixFmtReq )	/* Required pixel-format pixel format */
{
	GLboolean	succes;
	AGLPixelFmt result;
	int minGDepth,maxGDepth;
	
	/**
	 ** STEP 1: return NULL for unsupportted modes.
	 **/
	
	/*
	 * No over/underlay support.
	 */
	if (inPixFmtReq->overlayLevel != 0)
	{
		return NULL;
	}
	/*
	 * We are supporting only rgba pixel-fmts
	 */
	if (!inPixFmtReq->rgba) 
	{
	    return NULL;		
	}
	
	/*
	 * We don't support more than 8-bit's per components.
	 */
	if ((inPixFmtReq->redSize > 8) || (inPixFmtReq->greenSize >8) || (inPixFmtReq->blueSize > 8)) 
	{
		return NULL;		
	}
	
	/*
	 * We doesn't support alpha with more than 8-bit
	 */
	if (inPixFmtReq->alphaSize > 8) 
	{
		return NULL;		
	}
	
	/*
	 * We doesn't support stereo-buffers.
	 */
	if (inPixFmtReq->stereo) 
	{
		return NULL;
	}
	
	/*
	 * We doesn't support double-buffering (yet TODO).
	 */
	if (inPixFmtReq->doubleBuffer)
	{
		return NULL;
	}
	
	/**
	 ** STEP 2: Create and fill out the other parts of the result.
	 **/
	result = AGLAllocatePixelFormat(inPixFmtReq);
	
	if (result == NULL)
	{
		return NULL;
	}
	
	/*
	 * Set up color components
	 */
	result->redSize = 8;
	result->greenSize = 8;
	result->blueSize = 8;
	
	/*
	 * Alpha buffer:
	 */
	if (result->alphaSize > 0)
	{
		result->alphaSize = 8;
		result->softwareAlpha = GL_TRUE; /* Or GL_FALSE, if we support it */
	}
	else
	{
		result->alphaSize = 0;
		result->softwareAlpha = GL_FALSE;
	}
	
	result->colorDepth = 32;
	
	/*
	 * Set up solor scales.
	 */
	result->redScale = 255.0;
	result->greenScale = 255.0;
	result->blueScale = 255.0;
	result->alphaScale = 255.0;
	
	
	/*
	 * See if mesa is supports this pixel-fmt, and let it do the following setup.
	 */
	succes = DDUMesaSetupPixelFmt( result );
	
	if (!succes)
	{
		AGLDisposePixelFormat( result );
		return NULL;
	}
	
	/*
	 * Check if there is a drawing engine wich supports this device:
	 */
	{
		TQADevice 	device;
		TQAEngine	*engine;
		
		device.deviceType 		= kQADeviceGDevice;
		device.device.gDevice 	= *(inPixFmtReq->dev)/*GetGWorldDevice(inPixFmtReq->drawable)*/;
	
		/*
	 	 * TODO: select the best engine and return it's speed.
		 */
		engine = QADeviceGetFirstEngine(&device);
		
		if (engine == NULL)
		{
			AGLDisposePixelFormat( result );
			return NULL;
		}
		else
		{
			result->driverData[0] = (long)engine;
			result->speed = 32;
		}
	}
	
	return result;
}


/************************************************************************************************
 *
 * RAInitializeContext: Create the private draw context data.
 *
 ***********************************************************************************************/
static GLboolean RAInitializeContext(
				 GLcontext			*gl_ctx,	/* Draw context to initialize */
				 const AGLContext	aglCtx,		/* AGL context, for error registering */
				 const AGLPixelFmt	pixFmt,		/* Selected pixel-format */	
				 const AGLDrawable	drawable)	/* Target drawable */
{
	TRADriverPrivate *newDriverPrivate;
	long			 width, height;
	Rect			 rect;
	
	if (!AGLIsValidPixelFormat(pixFmt))
	{
		return GL_FALSE;
	}
	
	
	/*
	 * Allocate the TDDDiverPrivate structure.
	 */

	newDriverPrivate = (TRADriverPrivate *) AGLMemoryNewClear( sizeof( TRADriverPrivate));
	if (newDriverPrivate == NULL) 
	{
		AGLSetGLError(aglCtx,GL_OUT_OF_MEMORY,"RAInitializeContext: Out of memory!");
		return GL_TRUE;
	}
	
	/*
	 * Store a copy from the pixel-format, and from the drawable
	 */
	newDriverPrivate->pixFmt = *pixFmt;
	
	newDriverPrivate->drawable = drawable;
	
	newDriverPrivate->gl_ctx = gl_ctx;
	
	newDriverPrivate->aglCtx = aglCtx;
	
	/*
	 * Initialize the dimension of drawable.
	 */
	
	rect = drawable->portRect;
	newDriverPrivate->width = width = rect.right - rect.left;
	newDriverPrivate->height = height = rect.bottom - rect.top;
	

	
	/*
	 * Initialize the fornt (and back) buffer.
	 */
	 
	{
		Point		topLeft, botRight;
		TQARect 	drawableRect;
		TQAError 	status;
		TQADevice	device;
		long		flags;
    AGLDrawable	 savePort;
    
		
		/*
		 * Set the flags (TODO)
		 */
		
		flags = 0; 
		
		/*
	 	 * Get the boundaries of the drawable window, and compute its size.
	 	 */
		topLeft.v = drawable->portRect.top;
		topLeft.h = drawable->portRect.left;
		botRight.v = drawable->portRect.bottom;
		botRight.h = drawable->portRect.right;
		
		/*
		 * Convert window boundaries to global co-ordinates.
		 */
			
		DDUSetPort (drawable,NULL,&savePort);
		LocalToGlobal (&topLeft);
		LocalToGlobal (&botRight);
		DDURestorePort(&savePort);
		
		/*
		 * Create a rave device.
		 */
			
		device.deviceType = kQADeviceGDevice;
		device.device.gDevice = GetGWorldDevice(drawable);

		/*
		 * Create the bound rectangle in device coordinates.
		 */
					
		drawableRect.top = topLeft.v - (*device.device.gDevice)->gdRect.top;
		drawableRect.left = topLeft.h - (*device.device.gDevice)->gdRect.left;
		drawableRect.bottom = botRight.v - (*device.device.gDevice)->gdRect.top;
		drawableRect.right = botRight.h - (*device.device.gDevice)->gdRect.left;
		
		
		/*
		 * Choose a RAVE engine (TODO select the best):
		 */
			TQAEngine	*myEngine;
		{			
			myEngine = (TQAEngine*)(pixFmt->driverData[0]);
			newDriverPrivate->engine = myEngine;
			
			/*
			 * Chech if selected engine supports the drawable.
			 */ 
			status = QAEngineCheckDevice(myEngine,&device);
			
			if (status != kQANoErr)
			{
				AGLSetGLError(aglCtx,AGL_BAD_PIXELFMT,"RAInitialize context: Not valid RAVE Engine!");
				AGLMemoryDelete( (AGLPtr) newDriverPrivate);
				return GL_FALSE;
			}
		}
		
		/*
		 * Create the draw context.
		 */
		 
		status = QADrawContextNew (&device, &drawableRect,
				NULL, myEngine , flags, &newDriverPrivate->drawContext);
		
		if (status != kQAError)
		{
			AGLSetGLError(aglCtx,GL_OUT_OF_MEMORY,"RAInitialize context: Can't initialize RAVE Draw Context!");
			AGLMemoryDelete( (AGLPtr) newDriverPrivate);
			return GL_FALSE;
		} 
	}

	/*
	 * Initialize the gl_context
	 */
	gl_ctx->DriverCtx = newDriverPrivate;
	
	/*
	 * Do the basic setup for Mesa Ctx.
	 */
	 
	gl_ctx->Driver.Finish = RAFinish;
  	gl_ctx->Driver.Flush = RAFlush;
    
  	gl_ctx->Driver.SetBuffer = RASetBuffer;
  	gl_ctx->Driver.Clear = RAClear;
  	gl_ctx->Driver.ClearColor = RAClearColor;
  	gl_ctx->Driver.Color = RAColor;
  
  	gl_ctx->Driver.GetBufferSize = RAGetBufferSize;
  
  	gl_ctx->Driver.WriteColorSpan = RAWriteColorSpan; 
  	gl_ctx->Driver.WriteMonocolorSpan = RAWriteMonocolorSpan;
  
  	gl_ctx->Driver.WriteColorPixels = RAWriteColorPixels;
 	gl_ctx->Driver.WriteMonocolorPixels = RAWriteMonocolorPixels;

 	gl_ctx->Driver.ReadColorSpan  = RAReadColorSpanRGB;
 	gl_ctx->Driver.ReadColorPixels = RAReadColorPixelRGB;
  	
  	gl_ctx->Driver.UpdateState = RAUpdateState;
	
	return GL_TRUE;
}

