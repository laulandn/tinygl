}

/************************************************************************************************
 *
 * RADestroyContext: Delete private draw context data.
 *
 ***********************************************************************************************/

static GLboolean RADestroyContext(
		GLcontext *ctx) 	/* Context data to delete */
{
	TRADriverPrivate *myPrivate;
	
	myPrivate = (TRADriverPrivate*) ctx->DriverCtx;
	
	if (myPrivate->drawContext != NULL)
	{
		QADrawContextDelete(myPrivate->drawContext);
		myPrivate->drawContext = NULL;
	}
	
	AGLMemoryDelete((AGLPtr)myPrivate);
	
	ctx->DriverCtx = NULL;
	
	return GL_TRUE;
}

extern GLboolean RAVEGetPixelFmtData(UInt32 inMode, AGLPixelFmt *outPixFmtRec);

/************************************************************************************************
 * Converts pixelformat to driver mode.
 * Return GL_TRUE if we can draw to 'device'. For example, this code causes
 * this driver to be used for only 16 and 32 bit/pixel devices.
 ***********************************************************************************************/

GLboolean RAVEChooseMode(TAGLPixelFmtReq *inPixFmtReq, 	/* Minimal pixel format */
							 TDDSpeed *outSpeed,	/* The speed of this driver  */ 
							 UInt32 *outMode)		/* Mode to be returned */
{
	GLboolean	succes;
	UInt8 		result 		= 0;
	TAGLPixelFmtReq pixFmtRec 	= *inPixFmtReq;
	
	/*
	 * STEP 1: return GL_FALSE for unsupportted modes.
	 */
	
	if (!pixFmtRec.rgba) {
	    return GL_FALSE;		/* It supports only rgba pixel formats */
	}
	
	
	if ((pixFmtRec.redSize > 8) || (pixFmtRec.greenSize >8) || (pixFmtRec.blueSize > 8)) {
		return GL_FALSE;		/* It supports only max 8 bit color comopnents */
	}
	
	if (pixFmtRec.alphaSize > 8) {
		return GL_FALSE;		/* It doesn't supports alpha */
	}

	if (pixFmtRec.stereo) {
		return GL_FALSE;		/* It doesn't supports stereo */
	}
	

	
	/*
	 * STEP 2: convert the pixel format to a number (24 bit)
	 */
	 
	succes = DDUGetPixelFmtID(&pixFmtRec,outMode);
	if (!succes)
	{
		return GL_FALSE;
	} 
	
	/*
	 * STEP 3: See, whatever GL supports this pixel format.
	 * Note that you should call QDGetPixelFmtData (to be able to
	 * check the returned pixel format returned by the ID
	 */
	RAVEGetPixelFmtData(*outMode,&pixFmtRec);
	
	if (!DDUIsGLSupports(&pixFmtRec,&gDriverFT->driverInfo)) {
		return GL_FALSE;
	}
	
	/*
	 * STEP 3: set the outSpeed.
	 */
	 
	*outSpeed = 0;
	
	/*
	 * 
	 */
	if (!RAVEGetPixelFmtData(*outMode,&pixFmtRec))
	{
	  return GL_FALSE;
	}
	 
	return GL_TRUE;
}

/************************************************************************************************
 * Converts driver mode to pixel-format.
 * Return GL_TRUE if inMode is a valid pixel format. 
 * Returns the format description in outPixFmtRec.
 ***********************************************************************************************/
GLboolean RAVEGetPixelFmtData(const UInt32 		inMode, 		/* Mode to be converted */
							TAGLPixelFmt 		*outPixFmtRec)	/* PixelFormat to be returned */ 
{
	/*
	 * This is the default for most of drivers.
	 */
	return DDUGetPixelFmtData(inMode,outPixFmtRec);
}; 


/************************************************************************************************
 * Create the private draw context data.
 ***********************************************************************************************/
static GLboolean RAVEInitializeContext(
		AGLContext 			aglCtx,			/* Draw context to initialize */
		const TAGLPixelFmtReq 	*pixFmt,		/* Pixel format */
		const CGrafPtr  	drawable		/* Target drawable */
		)
{
	TDDUPortSave	 savePort;
	TQADevice		 myDevice;
	TQAEngine		 *myEngine;
	GDHandle		 qdDevice;
	TQAError		 error;
	TQARect			 myRect;
	GDHandle		 gDeviceHandle;
	TRADriverPrivate *newDriverPrivate;
	long			 width, height;
	long			 flags;
	Rect			 rect;
	Point			 topLeft;
	Point			 botRight;
		
	__aglAssert(aglCtx);
	__aglAssert(aglCtx->gl_ctx);
	
	
	/*
	 * Allocate the TDDDiverPrivate structure.
	 */

	newDriverPrivate = (TRADriverPrivate *) NewPtrClear ( sizeof( TRADriverPrivate));
	if (newDriverPrivate == NULL) 
	{
		return (GL_FALSE); 
	};
	
	newDriverPrivate->pixFmt = *pixFmt;
	newDriverPrivate->drawable = drawable;
	
	
	/*
	 * Initialize the fields that describe the front (drawable) buffer.
	 */
	 
	newDriverPrivate->device = qdDevice = GetGWorldDevice(drawable);
	newDriverPrivate->deviceRect = drawable->portRect;
	rect = drawable->portRect;
	
	newDriverPrivate->width = width = rect.right - rect.left;
	newDriverPrivate->height = height = rect.bottom - rect.top;
	
	/*
     * Create the RAVE device (TODO: check, whatever this is an offscreen thing or not).
	 */
	
	gDeviceHandle = GetGWorldDevice(drawable);
	myDevice.deviceType = kQADeviceGDevice;
	myDevice.device.gDevice = gDeviceHandle;
	
	/*
	 * Get the RAVE engine. (TODO: Select the best one.)
	 */
	myEngine = QADeviceGetFirstEngine(&myDevice);
	
	/*
	 * Convert drawable boundaries to global co-ordinates.
	 */
	DDUSetPort(drawable,NULL,&savePort);
	rect = drawable->portRect;
	topLeft.h = rect.left;
	topLeft.v = rect.top;
	botRight.h = rect.right;
	botRight.v = rect.bottom;
	LocalToGlobal (&topLeft);
	LocalToGlobal (&botRight);
	DDURestorePort(&savePort);
	
	/*
	 * Create the bound rectangle in device coordinates.
	 */
	myRect.left = topLeft.h - (*qdDevice)->gdRect.left;
	myRect.right = botRight.h - (*qdDevice)->gdRect.left;
	myRect.top = topLeft.v - (*qdDevice)->gdRect.top;
	myRect.bottom = botRight.v - (*qdDevice)->gdRect.top;
	
	
	/*
	 * Set up the context-flag
	 */
	 
	flags = kQAContext_None;
	if (pixFmt->doubleBuffer)
	{
		flags = flags | kQAContext_DoubleBuffer;
	}
	
	if (pixFmt->depthSize == 0)
	{
		flags = flags | kQAContext_NoZBuffer;
	}
	
	if (pixFmt->depthSize > 16)
	{
		flags = flags | kQAContext_DeepZ; /* TODO: See if the driver has Deep Z buffer */
	}
	
	/*
	 * Create the RAVE draw context.
	 */
	error = QADrawContextNew(&myDevice,&myRect,NULL,myEngine,flags,&newDriverPrivate->drawContext);
	
	if (error != kQANoErr)
	{
		/* TODO: ERROR */
		DisposePtr( (Ptr)newDriverPrivate );
		return NULL;
	}
	
	{
		PixMap	*devicePixMap;
		
		devicePixMap = *(**newDriverPrivate->device).gdPMap;
		
		newDriverPrivate->frontPort = drawable;
		newDriverPrivate->frontRowBytes = devicePixMap->rowBytes & 0x3fff;
		newDriverPrivate->frontDepth = devicePixMap->pixelSize;
		newDriverPrivate->frontBaseAddr = devicePixMap->baseAddr
					+ rect.left * (newDriverPrivate->frontDepth >> 3)
					+ rect.top * newDriverPrivate->frontRowBytes;
					
		/*
		 * Allocate back buffer if needed:
		 */
		 if (pixFmt->doubleBuffer)
		 {
		 	newDriverPrivate->backBuffer = DDUCreateBackBuffer(pixFmt->colorDepth,width,height);
		 	if (newDriverPrivate->backBuffer == NULL) 
		 	{
		 		__aglSetGLError(aglCtx,GL_OUT_OF_MEMORY,"QDInitializeContext: There is not enough memory to allocate the back buffer");
		 	};
		 } 
		 else 
		 {
		 	newDriverPrivate->backBuffer = NULL;
		 }
	}
	
	/*
	 * If a clip region is assigned, copy it into the private data. (TODO )
	 */
	 
	 
	
	/*
	 * Initialize the UpdateState methods and device private pointer, and return.
	 */

	aglCtx->updateState = RAVEUpdateState;
	aglCtx->driverPrivate = (TDDDriverPrivate*)newDriverPrivate;
	
	/*
	 * Set the current buffer to front or back buffer:
	 */
	RAVEDDSetBuffer(aglCtx->gl_ctx,newDriverPrivate->backBuffer ? GL_BACK : GL_FRONT);
	
	return GL_TRUE;
}

static GLboolean RAVESwapBuffers(AGLContext aglCtx, AGLDrawable drawable)
{
	TRADriverPrivate *myPrivate = (TRADriverPrivate*) aglCtx->driverPrivate;
	TQAError	error;
	
	__aglAssert(myPrivate);
	__aglAssert(myPrivate->backBuffer);
	
	if (drawable != myPrivate->frontPort) 
	{
		__aglSetAGLError(aglCtx,AGL_BAD_DRAWABLE,"RAVEDriver: drawable doesn't match with the one defined in aglMakeCurrent!");
		return GL_FALSE;
	}
	
	error = QARenderEnd(myPrivate->drawContext,NULL);
	
	if (error != kQANoErr)
	{
		__aglSetAGLError(aglCtx,AGL_BAD_DRAWABLE,"RAVEDriver: call to QARenderEnd failed!");
		return GL_FALSE;
	}
	
	return GL_TRUE;
}


/************************************************************************************************
 * Delete private draw context data.
 ***********************************************************************************************/
static GLboolean RAVEDestroyContext(
		TDDDriverPrivate *driverPrivate) 	/* Private context data to delete */
{
	TRADriverPrivate *myPrivate = (TRADriverPrivate*) driverPrivate;
	
	__aglAssert(driverPrivate);
	
	QARenderAbort(myPrivate->drawContext);
	QADrawContextDelete(myPrivate->drawContext);
	
	/*
	 * Dispose Back buffer if exists:
	 */
	
	if (myPrivate->backBuffer != NULL)
	{
		DDUDisposeBackBuffer(myPrivate->backBuffer);
		myPrivate->backBuffer = NULL;
	}	
	
	DisposePtr((Ptr)myPrivate);
	return GL_TRUE;
}

/************************************************************************************************
 * This function is called when the driver has custom color scales. 
 * The default is 8bit -> 0..255.0, etc...
 ************************************************************************************************/
static GLfloat RAVEDDGetColorScale(const int Color,const int bits)
{
	/*
	 * This RAVE driver likes the colors in 0..255.0
	 */
	if (bits != 0)
	{
		return 255.0;
	}
	else
	{
		return 0;
	}
}

/***************************************************************************************************
 * The size or the position changed, so modify the Context.
 * Note that size and pos can be GL_TURE at the same time!
 ***************************************************************************************************/
static GLboolean RAVEDrawableChanged( const AGLContext aglCtx, 
									const GLboolean posChanged, 		/* Is the pos changed? */
									const GLboolean sizeChanged )		/* Is the size changed? */
{
  TRADriverPrivate *myPrivate = (TRADriverPrivate*) aglCtx->driverPrivate;
  AGLDrawable drawable = myPrivate->drawable;
  Rect rect;
  
  /* TODO */
  return GL_TRUE;
}

/************************************************************************************************
 * Call this function to register this driver with DD_Managger. This is usually
 * called by the shared library initialization method. This function returns GL_TURE 
 * on success, GL_FALSE on error.
 ***********************************************************************************************/
GLboolean InstallRAVEDriver()
{
	TDDDriverFT *myDriverFT = (TDDDriverFT*)NewPtr(sizeof(TDDDriverFT));
	
	if (!gDriverInstalled) {
		myDriverFT->initializeContext = RAVEInitializeContext;
		myDriverFT->destroyContext = RAVEDestroyContext;
		myDriverFT->drawableChanged = RAVEDrawableChanged;
		myDriverFT->swapBuffers = RAVESwapBuffers;
		
		myDriverFT->chooseMode = RAVEChooseMode;
		myDriverFT->getPixFmtData = RAVEGetPixelFmtData;
		
		myDriverFT->driverInfo.supportAlpha = GL_TRUE;
		myDriverFT->driverInfo.customScales = GL_TRUE;
		myDriverFT->driverInfo.getColorScale = RAVEDDGetColorScale;
	}
	gDriverFT = myDriverFT;
	
	return DDRegisterDriver(gDriverFT);
}


