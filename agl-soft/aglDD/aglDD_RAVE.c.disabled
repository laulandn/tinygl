/************************************************************************************************
 *
 * RABufferSize: Returns the width and height of the current color buffer.
 * 
 ************************************************************************************************/
static void RAGetBufferSize( GLcontext *ctx, GLuint *width, GLuint *height )
{
	GET_PRIVATE_DATA(ctx,myPrivate);
	
	*width = myPrivate->width;
	*height = myPrivate->height;
}

/*************************************************************
 *
 * Accelerated Triangle/Line Functions:
 *
 *************************************************************/

static float frand (void)
{
	return ((Random() + 32768) / 65536.0);
}

void TestRandomVGouraud (
	TQAVGouraud		*v)
{
	v->x = frand() * 300;
	v->y = frand() * 300;
	v->z = frand();
	v->invW = 1.0 / v->z;
	
	v->a = 1.0;
	v->r = frand();
	v->g = frand();
	v->b = frand();
}
static void RADrawLine( GLcontext *ctx,
									GLuint v0, GLuint v1, GLuint pv)
{
	struct vertex_buffer *VB = ctx->VB;
	TQAVGouraud vertex0,vertex1;
	GET_PRIVATE_DATA(ctx,myPrivate);
	
	if (VB->MonoColor) {
		/*
		 * Set up the vertex's color from the current color.
		 */
		vertex0.r = myPrivate->currentColor.r;
		vertex1.r = myPrivate->currentColor.r;
		
		vertex0.g = myPrivate->currentColor.g;
		vertex1.g = myPrivate->currentColor.g;
		
		vertex0.b = myPrivate->currentColor.b;
		vertex1.b = myPrivate->currentColor.b;
		
		vertex0.a = myPrivate->currentColor.a;
		vertex1.a = myPrivate->currentColor.a;
	} 
	else {
		/*
		 * Set up the vertex's color from the Vertex Buffer.
		 */
		 vertex0.r = RAVEFixedToFloat(VB->Fcolor[v0][0]);
		 vertex0.g = RAVEFixedToFloat(VB->Fcolor[v0][1]);
		 vertex0.b = RAVEFixedToFloat(VB->Fcolor[v0][2]);
		 vertex0.a = 1.0; /* RAVEFixedToFloat(VB->Fcolor[v0][3]); */
		 
		 vertex1.r = RAVEFixedToFloat(VB->Fcolor[v1][0]);
		 vertex1.g = RAVEFixedToFloat(VB->Fcolor[v1][1]);
		 vertex1.b = RAVEFixedToFloat(VB->Fcolor[v1][2]);
		 vertex1.a = 1.0; /* RAVEFixedToFloat(VB->Fcolor[v1][3]); */
	}
	
	/*
	 * Set up corrdinates:
	 */
	vertex0.x = VB->Win[v0][0];
	vertex0.y = VB->Win[v0][1];
	vertex0.z = VB->Win[v0][2] / DEPTH_SCALE;
	
	vertex1.x = VB->Win[v1][0];
	vertex1.y = VB->Win[v1][1];
	vertex1.z = VB->Win[v1][2] / DEPTH_SCALE;
	
	/*
	 * Draw the line:
	 */
	 QADrawLine(myPrivate->drawContext,&vertex0,&vertex1);
	
}
static void RADrawTriangle( GLcontext *ctx,
									GLuint v0, GLuint v1, GLuint v2,	/* The vertexes of the triangle */ 
									GLuint pv )							/* The provoking vertex of this triangle */
{
	struct vertex_buffer *VB = ctx->VB;
	TQAVGouraud vertex0,vertex1,vertex2;
	GET_PRIVATE_DATA(ctx,myPrivate);

	
	if (VB->MonoColor) {
		/*
		 * Set up the vertex's color from the current color.
		 */
		vertex0.r = myPrivate->currentColor.r;
		vertex1.r = myPrivate->currentColor.r;
		vertex2.r = myPrivate->currentColor.r;
		
		vertex0.g = myPrivate->currentColor.g;
		vertex1.g = myPrivate->currentColor.g;
		vertex2.g = myPrivate->currentColor.g;
		
		vertex0.b = myPrivate->currentColor.b;
		vertex1.b = myPrivate->currentColor.b;
		vertex2.b = myPrivate->currentColor.b;
		
		vertex0.a = myPrivate->currentColor.a;
		vertex1.a = myPrivate->currentColor.a;
		vertex2.a = myPrivate->currentColor.a;
	}
	else {
		/*
		 * Set up the vertex's color from the Vertex Buffer.
		 */
		 vertex0.r = RAVEFixedToFloat(VB->Fcolor[v0][0]);
		 vertex0.g = RAVEFixedToFloat(VB->Fcolor[v0][1]);
		 vertex0.b = RAVEFixedToFloat(VB->Fcolor[v0][2]);
		 vertex0.a = 1.0; /* RAVEFixedToFloat(VB->Fcolor[v0][3]); */
		 
		 vertex1.r = RAVEFixedToFloat(VB->Fcolor[v1][0]);
		 vertex1.g = RAVEFixedToFloat(VB->Fcolor[v1][1]);
		 vertex1.b = RAVEFixedToFloat(VB->Fcolor[v1][2]);
		 vertex1.a = 1.0; /* RAVEFixedToFloat(VB->Fcolor[v1][3]); */
		 
		 vertex2.r = RAVEFixedToFloat(VB->Fcolor[v2][0]);
		 vertex2.g = RAVEFixedToFloat(VB->Fcolor[v2][1]);
		 vertex2.b = RAVEFixedToFloat(VB->Fcolor[v2][2]);
		 vertex2.a = 1.0; /* RAVEFixedToFloat(VB->Fcolor[v2][3]); */
	}
	
	/*
	 * Set up corrdinates:
	 */
	vertex0.x = VB->Win[v0][0];
	vertex0.y = VB->Win[v0][1];
	vertex0.z = VB->Win[v0][2] / DEPTH_SCALE;
	
	vertex1.x = VB->Win[v1][0];
	vertex1.y = VB->Win[v1][1];
	vertex1.z = VB->Win[v1][2] / DEPTH_SCALE;
	
	vertex2.x = VB->Win[v2][0];
	vertex2.y = VB->Win[v2][1];
	vertex2.z = VB->Win[v2][2] / DEPTH_SCALE;
	

	/*
	 * Set up invW : 1/w;
	 */
	/* vertex0.invW = 1/vertex0.z;
	vertex1.invW = 1/vertex1.z;
	vertex2.invW = 1/vertex2.z; */
	
	/*
	 * Draw the triangle:
	 */
	 
	QADrawTriGouraud(myPrivate->drawContext,&vertex0,&vertex1,&vertex2,kQATriFlags_None);
}

/************************************************************************************************
 *
 *	RAFlush
 *
 ***********************************************************************************************/
static void RAFlush(
		 GLcontext *ctx )		/* Draw context */
{
	TRADriverPrivate		*myPrivate;
	
	myPrivate = (TRADriverPrivate *) ctx->DriverCtx;
	
	/*
	 * If rendering commands are queued, start running them.
	 */
	QAFlush(myPrivate->drawContext);
}

/************************************************************************************************
 *
 *	RAFinish
 *
 ***********************************************************************************************/
static void RAFinish( 
			GLcontext *ctx )	/* Draw context */
{
	TRADriverPrivate		*myPrivate;
	
	myPrivate = (TRADriverPrivate *) ctx->DriverCtx;
	
	/*
	 * Don't return until all outstanding rendering is complete.
	 */
	QASync(myPrivate->drawContext);
}

/************************************************************************************************
 *
 *	RASetBuffer:  Selects either the front or back color buffer for reading and writing. 
 *				  Mode is either GL_FRONT or GL_BACK.
 *
 ***********************************************************************************************/
static GLboolean RASetBuffer( GLcontext *ctx, GLenum mode )
{
	TRADriverPrivate		*myPrivate;
	
	myPrivate = (TRADriverPrivate *) ctx->DriverCtx;
	
	/*
	 * QD RAVE Doesn't support this so only an error handler.
	 */
 	if (mode == GL_FRONT) 
 	{
 		if (myPrivate->pixFmt.doubleBuffer) 
 		{
 			AGLSetGLError(ctx->DriverCtx,GL_INVALID_OPERATION,"RAVE Driver can't draw to the front buffer of a double buffered context!");
 		}
 	}
 	else if (mode == GL_BACK && myPrivate->pixFmt.doubleBuffer)
 	{
 		
 	}
 	else
 	{
 		AGLSetGLError(ctx->DriverCtx,GL_INVALID_OPERATION,"Invalid operation in __aglDD_SetBuffer!");
 		return GL_FALSE;
 	}
 	
 	return GL_TRUE;
}

/************************************************************************************************
 *
 *	RAClearColor: Set the color for clearing the color buffer.
 *
 ***********************************************************************************************/

static void RAClearColor( GLcontext *ctx,				/* Draw context */
                         GLubyte red, GLubyte green,
                         GLubyte blue, GLubyte alpha )
{
	TRADriverPrivate		*myPrivate;
	
	myPrivate = (TRADriverPrivate *) ctx->DriverCtx;
   
	QASetFloat(myPrivate->drawContext,kQATag_ColorBG_r,red/255.0);
	QASetFloat(myPrivate->drawContext,kQATag_ColorBG_r,green/255.0);
	QASetFloat(myPrivate->drawContext,kQATag_ColorBG_r,blue/255.0);
	QASetFloat(myPrivate->drawContext,kQATag_ColorBG_r,alpha/255.0);
}

/************************************************************************************************
 *
 *	RAColor: Sets current color for drawing flat-shaded primitives..
 *
 ***********************************************************************************************/
static void RAColor( GLcontext *ctx,						/* Draw context */
                         GLubyte red, GLubyte green,		/* The drawing color's red/green/blue/alpha value */
                         GLubyte blue, GLubyte alpha )
{
	TRADriverPrivate		*myPrivate;
	
	myPrivate = (TRADriverPrivate *) ctx->DriverCtx;
	
	myPrivate->currentColor.r = red/255.0;
	myPrivate->currentColor.g = green/255.0;
	myPrivate->currentColor.b = blue/255.0;
	myPrivate->currentColor.a = alpha/255.0;
}

/************************************************************************************************
 *
 *	RAClear: Clear the current color buffer.  If 'all' is set the clear the whole buffer,
 *   	      else clear the region defined by (x,y,width,height).
 *	TODO: MAKE A RAVE RECT IF NOT THE WHOLE IS CLEARED
 *
 ***********************************************************************************************/
 
static void RAClear( 	GLcontext *ctx,									/* Draw context */
					   	GLboolean all,									/* GL_TRUE means the whole buffer */
						GLint x, GLint y, GLint width, GLint height)	/* Area to clear */
{
	Rect 					clearRect;
	//TDDUPortSave 			portSave;
	TRADriverPrivate		*myPrivate;
	
	myPrivate = (TRADriverPrivate *) ctx->DriverCtx;
	

	/*
	 * Set the area to clear.
	 */
	if (all) 
	{
		SetRect(&clearRect,0,0,myPrivate->width,myPrivate->height); 
	} 
	else 
	{
		SetRect(&clearRect,x,AGL_FLIP(y+height),x+width,AGL_FLIP(y));
	}
	
	
	QARenderStart(myPrivate->drawContext,(TQARect *)&clearRect,NULL);
}





