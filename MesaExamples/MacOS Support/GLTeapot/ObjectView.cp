#include "ObjectView.h"#include "GLObject.h"#include "glu.h"#define teapotData "teapot.data"// Globalsfloat gDisplayScale = 1.0;float gDepthOfView = 30.0;float gZRatio = 10.0;float gWhite[3] = {1.0,1.0,1.0};float gDimWhite[3] = {0.25,0.25,0.25};float gBlack[3] = {0.0,0.0,0.0};float gFoggy[3] = {0.4,0.4,0.4};float gBlue[3] = {0.0,0.0,1.0};float gDimBlue[3] = {0.0,0.0,0.5};float gYellow[3] = {1.0,1.0,0.0};float gDimYellow[3] = {0.5,0.5,0.0};float gGreen[3] = {0.0,1.0,0.0};float gDimGreen[3] = {0.0,0.5,0.0};float gRed[3] = {1.0,0.0,0.0};float *gBgColor = gBlack;struct TLight {	float *fAmbient;	float *fDiffuse;	float *fSpecular;};TLight gLights[] = {	{NULL,NULL,NULL},	{gDimWhite,gWhite,gWhite},	{gDimWhite,gYellow,gYellow},	{gDimWhite,gRed,gRed},	{gDimWhite,gBlue,gBlue},	{gDimWhite,gGreen,gGreen}};// ---------------------------------------------------------------------------//		¥ ObjectView(LStream*)				Stream Constructor		  [public]// ---------------------------------------------------------------------------ObjectView::ObjectView(	LStream *inStream)	: CGLPane(inStream){    mLastGouraud = mGouraud = true;	mLastZBuf = mZBuf = true;	mLastCulling = mCulling = false;	mLastLighting = mLighting = true;	mLastFilled = mFilled = true;	mLastPersp = mPersp = false;	mLastFog = mFog = false;	mLastTextured = mTextured = false;			mLastObjectDistance = mObjectDistance = gDepthOfView/8;	mForceRedraw = false;	mLastYXRatio = mYXRatio = 1;		mFPS = true;	/* Read the teapot data */	mObject = new TriangleObject(this,teapotData);		// Call AttachedToWindow	AttachedToWindow();}// ---------------------------------------------------------------------------//		¥ SpinIt()					  [public]// ---------------------------------------------------------------------------bool ObjectView::RepositionView(){	if (!(mPersp != mLastPersp) &&		!(mLastObjectDistance != mObjectDistance) &&		!(mLastYXRatio != mYXRatio)) {		return false;	};	LockGL();	glMatrixMode(GL_PROJECTION);	glLoadIdentity();	float scale=gDisplayScale;	if (mPersp) {	  gluPerspective(60,1.0/mYXRatio,0.15,120);	} else {	  if (mYXRatio < 1) {		glOrtho(-scale/mYXRatio, scale/mYXRatio, -scale, scale,				-1.0, gDepthOfView*4);	  } else {		glOrtho(-scale, scale, -scale*mYXRatio, scale*mYXRatio,				-1.0, gDepthOfView*4);	  };	};	glMatrixMode(GL_MODELVIEW);	UnlockGL();		mLastObjectDistance = mObjectDistance;	mLastPersp = mPersp;	mLastYXRatio = mYXRatio;	return true;};// ---------------------------------------------------------------------------//		¥ ListenToMessage								 			  [public]// ---------------------------------------------------------------------------//	Respond to messages from Broadcastersvoid		ObjectView::ListenToMessage(								MessageT inMessage, 								void *ioParam){	bool *b;		// A checkbox changed pass to the Object View.	switch(inMessage) {		case kMsgFPS:			/* TODO */			break;		case kMsgGouraud:			mGouraud = *(Int32*)ioParam;			break;		case kMsgZBuffer:			mZBuf = *(Int32*)ioParam;			break;		case kMsgCulling:			mCulling = *(Int32*)ioParam;			break;		case kMsgLighting:			mLighting = *(Int32*)ioParam;			break;		case kMsgFilled:			mFilled = *(Int32*)ioParam;			break;		case kMsgFog:			mFog = *(Int32*)ioParam;		default:			break;	};}// ---------------------------------------------------------------------------//		¥ SpinIt()					  [public]// ---------------------------------------------------------------------------bool ObjectView::SpinIt(){	bool changed = false;	if (mGouraud != mLastGouraud) {		LockGL();		glShadeModel(mGouraud?GL_SMOOTH:GL_FLAT);		UnlockGL();		mLastGouraud = mGouraud;		changed = true;	};	if (mZBuf != mLastZBuf) {		LockGL();		if (mZBuf) glEnable(GL_DEPTH_TEST); else glDisable(GL_DEPTH_TEST);		UnlockGL();		mLastZBuf = mZBuf;		changed = true;	};	if (mCulling != mLastCulling) {		LockGL();		if (mCulling) glEnable(GL_CULL_FACE); else glDisable(GL_CULL_FACE);		UnlockGL();		mLastCulling = mCulling;		changed = true;	};	if (mLighting != mLastLighting) {		LockGL();		if (mLighting) glEnable(GL_LIGHTING); else glDisable(GL_LIGHTING);		UnlockGL();		mLastLighting = mLighting;		changed = true;	};	if (mFilled != mLastFilled) {		LockGL();		if (mFilled) {			glPolygonMode(GL_FRONT_AND_BACK,GL_FILL);		} else {			glPolygonMode(GL_FRONT_AND_BACK,GL_LINE);		};		UnlockGL();		mLastFilled = mFilled;		changed = true;	};	if (mFog != mLastFog) {		if (mFog) {			glFogf(GL_FOG_START,1.0);			glFogf(GL_FOG_DENSITY,0.2);			glFogf(GL_FOG_END,gDepthOfView);			glFogfv(GL_FOG_COLOR,gFoggy);			glEnable(GL_FOG);			gBgColor = gFoggy;			glClearColor(gBgColor[0],gBgColor[1],gBgColor[2], 1.0);		} else {			glDisable(GL_FOG);			gBgColor = gBlack;			glClearColor(gBgColor[0],gBgColor[1],gBgColor[2], 1.0);		};		mLastFog = mFog;		changed = true;	};		changed = changed || RepositionView();	changed = changed || mForceRedraw;	mForceRedraw = false;	{		bool hack = mObject->SpinIt();		changed = changed || hack;	};		return changed;	}// ---------------------------------------------------------------------------//		¥ AttachedToWindow()					  [public]// ---------------------------------------------------------------------------void ObjectView::AttachedToWindow(){	float position[] = {0.0, 3.0, 3.0, 0.0};	float position1[] = {-3.0, -3.0, 3.0, 0.0};	float position2[] = {3.0, 0.0, 0.0, 0.0};	float local_view[] = {0.0,0.0};	float ambient[] = {0.1745, 0.03175, 0.03175};	float diffuse[] = {0.61424, 0.10136, 0.10136};	float specular[] = {0.727811, 0.626959, 0.626959};/*	Window()->SetPulseRate(100000); */		LockGL();	glEnable(GL_DITHER);	glEnable(GL_CULL_FACE);	glCullFace(GL_FRONT);	glDepthFunc(GL_LESS);	glShadeModel(GL_SMOOTH);		glLightfv(GL_LIGHT0, GL_POSITION, position);	glLightfv(GL_LIGHT1, GL_POSITION, position1);	glLightfv(GL_LIGHT2, GL_POSITION, position2);	glLightModelfv(GL_LIGHT_MODEL_LOCAL_VIEWER, local_view);	glEnable(GL_LIGHT0);	glLightfv(GL_LIGHT0, GL_SPECULAR, gLights[lightWhite].fSpecular);	glLightfv(GL_LIGHT0, GL_DIFFUSE,gLights[lightWhite].fDiffuse);	glLightfv(GL_LIGHT0, GL_AMBIENT,gLights[lightWhite].fAmbient);	glEnable(GL_LIGHT1);	glLightfv(GL_LIGHT1, GL_SPECULAR, gLights[lightBlue].fSpecular);	glLightfv(GL_LIGHT1, GL_DIFFUSE,gLights[lightBlue].fDiffuse);	glLightfv(GL_LIGHT1, GL_AMBIENT,gLights[lightBlue].fAmbient);			glFrontFace(GL_CW);	glEnable(GL_LIGHTING);	glEnable(GL_AUTO_NORMAL);	glEnable(GL_NORMALIZE);		glMaterialf(GL_FRONT, GL_SHININESS, 0.6*128.0);	glClearColor(gBgColor[0],gBgColor[1],gBgColor[2], 1.0);	glColor3f(1.0, 1.0, 1.0);		SDimension16 portSize;		GetFrameSize(portSize);		glViewport(0, 0, portSize.width, portSize.height);	glMatrixMode(GL_PROJECTION);	glLoadIdentity();	float scale=gDisplayScale;	//    glOrtho (0.0, 16.0, 0, 16.0*(GLfloat)300/(GLfloat)300,	//			         -10.0, 10.0);	glOrtho(-scale, scale, -scale, scale, -scale*gDepthOfView,			scale*gDepthOfView);	glMatrixMode(GL_MODELVIEW);	glLoadIdentity();	UnlockGL();};void ObjectView::DetachedFromWindow(){};// ---------------------------------------------------------------------------//	¥ ~LAttachable							Destructor				  [public]// ---------------------------------------------------------------------------ObjectView::~ObjectView(){	// Call DetachedFromWindow	DetachedFromWindow();	if (mObject != nil)		delete mObject;}// ---------------------------------------------------------------------------//		¥ EnforceState												[ public ]// ---------------------------------------------------------------------------//	Draws something with OpenGL.void ObjectView::EnforceState(){	glShadeModel(mGouraud?GL_SMOOTH:GL_FLAT);	if (mZBuf) glEnable(GL_DEPTH_TEST); else glDisable(GL_DEPTH_TEST);	if (mCulling) glEnable(GL_CULL_FACE); else glDisable(GL_CULL_FACE);	if (mLighting) glEnable(GL_LIGHTING); else glDisable(GL_LIGHTING);	if (mLastFilled) {		glPolygonMode(GL_FRONT_AND_BACK,GL_FILL);	} else {		glPolygonMode(GL_FRONT_AND_BACK,GL_LINE);	};	if (mFog) {		glFogf(GL_FOG_START,10.0);		glFogf(GL_FOG_DENSITY,0.2);		glFogf(GL_FOG_END,gDepthOfView);		glFogfv(GL_FOG_COLOR,gFoggy);		glEnable(GL_FOG);		gBgColor = gFoggy;		glClearColor(gBgColor[0],gBgColor[1],gBgColor[2], 1.0);	} else {		glDisable(GL_FOG);		gBgColor = gBlack;		glClearColor(gBgColor[0],gBgColor[1],gBgColor[2], 1.0);	};	}// ---------------------------------------------------------------------------//		¥ DrawSelf													[ public ]// ---------------------------------------------------------------------------//	Draws something with OpenGL.void ObjectView::DrawSelf(){	LockGL();	glClear(GL_COLOR_BUFFER_BIT|(mZBuf?GL_DEPTH_BUFFER_BIT:0));		{		GLObject *o;		o = mObject;		if (o->solidity==0)			o->Draw(false, NULL);	}	EnforceState();	{		GLObject *o;		o = mObject;		if (o->solidity!=0)			o->Draw(false, NULL);	}		glDisable(GL_BLEND);	glDepthMask(GL_TRUE);		SwapBuffers();	UnlockGL();	SpinIt();	Refresh();}