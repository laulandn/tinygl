trol->AddListener(inListener);	}	}// ---------------------------------------------------------------------------//		¥ ResizeFrameBy											   [protected]// ---------------------------------------------------------------------------//	Change the Frame size by the specified amounts////		inWidthDelta and inHeightDelta specify, in pixels, how much larger//		to make the Frame. Positive deltas increase the size, negative deltas//		reduce the size.voidCObjectWindow::ResizeFrameBy(	Int16		inWidthDelta,	Int16		inHeightDelta,	Boolean		inRefresh){	// This is a hack (TODO)	LWindow::ResizeFrameBy(inWidthDelta,inHeightDelta,true);	GWorldPtr	oldPort;	GDHandle	oldDev;		GetGWorld(&oldPort,&oldDev);	SetGWorld((GWorldPtr)GetMacPort(),nil);	EraseRect(&GetMacPort()->portRect);		SetGWorld(oldPort,oldDev);	}// ---------------------------------------------------------------------------//		¥ ObeyCommand										          [public]// ---------------------------------------------------------------------------//	Handle a commandBooleanCObjectWindow::ObeyCommand(	CommandT	inCommand,	void		*ioParam){	Boolean		cmdHandled = true;		switch (inCommand) {					default:			cmdHandled = LWindow::ObeyCommand(inCommand, ioParam);			break;	}			return cmdHandled;}// ---------------------------------------------------------------------------//		¥ ~LWindow												       [public]// ---------------------------------------------------------------------------//	DestructorCObjectWindow::~CObjectWindow(){	mObjectView = nil;}