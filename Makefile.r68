include config.mk.r68

all:
#	( for f in $(DIRS); do ( cd $$f ; make -f Makefile.r68 all ) || exit 1 ; done )
	make  -C source -f Makefile.r68
	make  -C agl-mini -f Makefile.r68
	make  -C agl-soft -f Makefile.r68
	make  -C GLUT_apple -f Makefile.r68
	make  -C src-glu -f Makefile.r68
	cp */*.a .
	make  -C examples -f Makefile.r68
	$(AR) rcv libTinyOpenGLLibrary.a source/*.o agl-mini/*.o
	$(RANLIB) libTinyOpenGLLibrary.a
	$(AR) rcv libTinyOpenGLUtility.a src-glu/*.o
	$(RANLIB) libTinyOpenGLUtility.a

install:
	make -f Makefile.r68 all
	# NOTE: Do NOT copy the include files!
	cp libglu.a libglut.a libMesaOpenGLLibrary.a libMesaOpenGLUtility.a $(HOME)/Retro68-build/toolchain/powerpc-apple-macos/lib/.
	
clean:
	rm -f *~ lib/libTinyGL.a include/GL/*~ TAGS
#	( for f in $(DIRS); do ( cd $$f ; make -f Makefile.r68 clean ; ) done )
	make  -C source -f Makefile.r68 clean
	make  -C examples -f Makefile.r68 clean
	make  -C MesaExamples -f Makefile.r68 clean
	make  -C agl-mini -f Makefile.r68 clean
	make  -C agl-soft -f Makefile.r68 clean
	make  -C GLUT_apple -f Makefile.r68 clean
	make  -C src-glu -f Makefile.r68 clean
	rm -rf *.a

install:
#	( for f in $(DIRS); do ( cd $$f ; make -f Makefile.r68 install ; ) done )


tar:
#	( cd .. ; tar zcvf /tmp/TinyGL-0.4.1.tar.gz TinyGL --exclude .svn --exclude TAGS )
